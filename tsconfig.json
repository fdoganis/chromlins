{
    "compilerOptions": {
        "allowJs": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "noEmit": true,
        "rootDir": "src",
        "outDir": "dist",
        "module": "es2022",
        "target": "es2022",
        "moduleResolution": "bundler",
        "strict": true,
        "sourceMap": true,
        "typeRoots": [
            "node_modules/@types"
        ],
        "lib": [
            "es2022",
            "dom"
        ]
    },
    "include": [
        "**/*.ts",
        "../vite.config.js"
    ],
    "exclude": [
        "node_modules",
        "tests",
        "playwright.config.ts",
        "knip.config.ts"
    ]
}